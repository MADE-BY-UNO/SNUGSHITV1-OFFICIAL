-- SLIDER
--==================================================

local function Slider(parent, text, y, default, callback)

	local label = New("TextLabel", parent, {
		Position = UDim2.fromOffset(15, y),
		Size = UDim2.new(1, -30, 0, 20),
		BackgroundTransparency = 1,
		Text = text .. ": " .. default .. "%",
		TextColor3 = Color3.fromRGB(220, 220, 225),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham
	})

	local bar = New("Frame", parent, {
		Position = UDim2.fromOffset(15, y + 25),
		Size = UDim2.new(1, -30, 0, 8),
		BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	})

	Round(bar, 5)

	local fill = New("Frame", bar, {
		Size = UDim2.new(default / 100, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(110, 70, 190)
	})

	Round(fill, 5)

	local dragging = false

	local function Update(x)

		local percent = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		local value = math.clamp(
			math.floor(percent * 99) + 1,
			1,
			100
		)

		fill.Size = UDim2.new(
			value / 100,
			0,
			1,
			0
		)

		label.Text = text .. ": " .. value .. "%"

		callback(value)
	end

	bar.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			Update(input.Position.X)
		end

	end)

	UIS.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			Update(input.Position.X)
		end

	end)

	UIS.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end

	end)
end

