local function GetDummies()

	local folder =
		workspace:FindFirstChild(
			"TrainingDummies"
		)

	if not folder then
		return {}
	end

	return folder:GetChildren()
end

local function SetDummyHitbox(enabled)

	for _, dummy in ipairs(
		GetDummies()
	) do

		if not dummy:IsA("Model") then
			continue
		end

		for _, part in ipairs(
			dummy:GetDescendants()
		) do

			if part:IsA("BasePart") then

				if part:GetAttribute(
					"SNUG_OriginalSize"
				) == nil then

					part:SetAttribute(
						"SNUG_OriginalSize",
						part.Size
					)
				end

				local original =
					part:GetAttribute(
						"SNUG_OriginalSize"
					)

				if typeof(original)
					== "Vector3" then

					if enabled then
						part.Size =
							original * 2
					else
						part.Size =
							original
					end
				end
			end
		end
	end
end

local function SetBigHead(enabled)

	for _, dummy in ipairs(
		GetDummies()
	) do

		if not dummy:IsA("Model") then
			continue
		end

		local head =
			dummy:FindFirstChild("Head")

		if head
			and head:IsA("BasePart") then

			if head:GetAttribute(
				"SNUG_OriginalHeadSize"
			) == nil then

				head:SetAttribute(
					"SNUG_OriginalHeadSize",
					head.Size
				)
			end

			local original =
				head:GetAttribute(
					"SNUG_OriginalHeadSize"
				)

			if typeof(original)
				== "Vector3" then

				if enabled then
					head.Size =
						original * 2
				else
					head.Size =
						original
				end
			end
		end
	end
end

